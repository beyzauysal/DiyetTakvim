{
  "version": 2,
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...all]"
    },
    {
      "source": "/(.*)",
      "destination": "/api/[...all]"
    }
  ],
  "functions": {
    "api/[...all].js": {
      "maxDuration": 30
    }
  }
}
