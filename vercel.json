{
  "version": 2,
  "installCommand": "cd backend && npm ci",
  "builds": [
    {
      "src": "backend/api/[...all].js",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/api/[...all].js"
    }
  ]
}
